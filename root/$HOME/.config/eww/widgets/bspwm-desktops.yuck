(defwidget bspwm-desktops []
  ; Use eventbox to set cursor. See: https://github.com/elkowar/eww/issues/251
  (eventbox
    :cursor "pointer"
    :visible show_bspwm
    (box
      :class "desktops"
      :space-evenly false
      :orientation "v"
      (for desktop in bspwm-desktops-json
        (button
          :class "desktops__desktop button ${desktop.occupied ? "desktops__desktop--occupied" : ""} ${desktop.focused ? "desktops__desktop--focused" : ""} ${desktop.urgent ? "desktops__desktop--urgent" : ""}"
          :onclick `bspc desktop -f ${desktop.id}`
          {desktop.name}
        )
      )
    )
  )
)
