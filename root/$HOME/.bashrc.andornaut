export EDITOR=/usr/bin/vim
export GOPATH="${HOME}"
export HISTSIZE=10000
export HISTFILESIZE=100000
export SYSTEMD_EDITOR=$EDITOR

# Guard each entry on its own: this file runs per interactive shell, and a
# nested one inherits the exported value, so an unguarded append adds a
# duplicate per level of nesting. One sentinel for the whole list would let
# any other source of a single entry suppress the rest.
for d in "${HOME}/bin" "${HOME}/.local/bin" /usr/local/go/bin; do
    case ":${PATH}:" in
        *":${d}:"*) ;;
        *) PATH="${PATH}:${d}" ;;
    esac
done
export PATH
unset d
# /etc/X11/Xsession.d/20flatpak adds these to a graphical session; the guard
# covers a shell started outside one, such as a tty login.
case ":${XDG_DATA_DIRS}:" in
    *":/var/lib/flatpak/exports/share:"*) ;;
    *) export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:${HOME}/.local/share/flatpak/exports/share" ;;
esac

function runCached {
    local -a command=("$@")
    if command -v cache-command >/dev/null; then
        cache-command -e 86400 -b /tmp/cache-command -- "${command[@]}"
    else
        "${command[@]}"
    fi
}

function httptunnel {
    [[ "$#" -gt 1 && "$#" -lt 5 ]] || { echo 'Usage: http-tunnel jumpHost targetHost [remotePort] [localPort]' >&2 ; return 1; }
    local jumpHost=$1
    local targetHost=$2
    local remotePort=${3-80}
    local localPort=${4-1111}
    local protocol
    protocol="$([[ ${remotePort} == "80" ]] && echo http || echo https)"
    echo "Make sure that 'AllowTCPForwarding yes' is set in ${jumpHost}:/etc/ssh/sshd_config"

    ( sleep 3 ; xdg-open "${protocol}://localhost:${localPort}" ;) &
    ssh -vL "${localPort}:${targetHost}:${remotePort}" -Nf "${jumpHost}"
}

function p {
    if [[ $# -ne 1 ]]; then
        echo 'Usage: p directoryPrefix';
        return 1
    fi

    local globPattern=$1
    # Strip trailing slashes, which tab completion appends. A pattern ending in
    # "/" takes the -ipath branch below and only matches subdirectories of the
    # project (eg. .git), never the project directory itself.
    while [[ ${globPattern} == */ ]]; do
        globPattern=${globPattern%/}
    done
    # The globs must expand here: quoting one makes it a literal string that
    # never matches a directory, which leaves only the two plain paths live.
    local searchPaths=("${HOME}/src/github.com/andornaut" "${HOME}"/src/github.com/[Ss]* \
        "${HOME}"/src/github.com/* "${HOME}/src" "${HOME}"/src/*)
    local projectPath root
    for root in "${searchPaths[@]}"; do
        if [[ ! -d "${root}" ]]; then
            continue
        fi
        if [[ "${globPattern}" =~ .*"/".* ]]; then
            projectPath="$(find "${root}" -maxdepth 2 -mindepth 1 -type d -ipath '*'"${globPattern}"'*'|sort|head -n1)"
        else
            projectPath="$(find "${root}" -maxdepth 1 -mindepth 1 -type d -iname "${globPattern}"'*'|sort|head -n1)"
        fi
        if [[ ! -d "${projectPath}" ]]; then
            continue
        fi

        cd "${projectPath}" || return 1
        echo "${projectPath}"

        # Git
        if [[ -d .git ]]; then
            local branch
            if ! branch=$(git cb 2>/dev/null); then
                branch=$(git dbr)
            fi
            echo "git: ${branch}"
        fi
        # JavaScript
        # Change the default node version with:
        #   nvm ls
        #   nvm use stable
        #   nvm alias default $(nvm current)
        # `nvm use` walks up from the current directory for an .nvmrc, reaching
        # ~/.nvmrc for a project that has none, so the version the previous
        # project selected is not kept. Fall back to the default only when no
        # .nvmrc is found anywhere; every other failure, such as a pinned
        # version that is not installed, has to stay visible.
        if [[ -n ${NVM_DIR} && -d ${NVM_DIR} ]] && declare -F nvm >/dev/null; then
            local nvmOutput
            if nvmOutput="$(nvm use 2>&1)"; then
                echo "${nvmOutput}"
            elif [[ ${nvmOutput} == *"No .nvmrc file found"* ]]; then
                nvm use default
            else
                echo "${nvmOutput}" >&2
            fi
        fi
        # Python
        # Drop a venv carried in from a previous project, so a project without
        # one is entered with no venv active.
        if [[ -n ${VIRTUAL_ENV} ]]; then
            if declare -F deactivate >/dev/null; then
                deactivate
            else
                # Inherited from a parent process: VIRTUAL_ENV is exported but
                # the deactivate function is not, so undo it by hand. Compare
                # entry by entry: a substitution over the whole string leaves
                # the second of two adjacent duplicates in place, and a
                # trailing slash on VIRTUAL_ENV matches nothing at all.
                local venvBin="${VIRTUAL_ENV%/}/bin" cleanPath='' entry
                local -a pathEntries
                IFS=: read -ra pathEntries <<<"${PATH}"
                for entry in "${pathEntries[@]}"; do
                    [[ ${entry} == "${venvBin}" ]] && continue
                    cleanPath="${cleanPath:+${cleanPath}:}${entry}"
                done
                # Keep PATH populated: it held nothing but the venv otherwise.
                export PATH="${cleanPath:-/usr/local/bin:/usr/bin:/bin}"
                unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT
            fi
        fi
        # Activate in this shell: `poetry shell` and `pipenv shell` spawn a
        # subshell, which stacks one level per call and which `deactivate`
        # cannot undo.
        local venv
        if venv="$(poetry env info --path 2>/dev/null)" && [[ -f ${venv}/bin/activate ]]; then
            source "${venv}/bin/activate"
        elif [[ -f Pipfile ]] && venv="$(pipenv --venv 2>/dev/null)" && [[ -f ${venv}/bin/activate ]]; then
            source "${venv}/bin/activate"
        elif [[ -f .venv/bin/activate ]]; then
            source .venv/bin/activate
        fi
        return 0
    done
    echo "No project matches: ${globPattern}" >&2
    return 1
}

xresize() {
    if [[ $# -ne 1 ]]; then
      echo "Usage: xresize WIDTHxHEIGHT | xresize WIDTH"
      return 1
    fi

    local w="${1%%x*}"
    local h="${1#*x}"
    [[ "$1" != *x* ]] && h=""

    echo "Click a window to resize..."
    local wid
    wid=$(xdotool selectwindow) || return 1

    if [[ -z "$h" ]]; then
      h=$(xdotool getwindowgeometry --shell "$wid" | grep HEIGHT | cut -d= -f2)
    fi

    xdotool windowsize "$wid" "$w" "$h"
}

gogstart() {
    local r rev ok failed=0
    for r in $(gog repository ls); do
        ok=1
        # Apply even when the pull fails: an unreachable or unauthenticated
        # remote shouldn't leave the repo's symlinks unapplied.
        gog -r "${r}" git start >/dev/null || { echo "Failed to update: ${r}" >&2; ok=0; }
        gog -r "${r}" apply || { echo "Failed to apply: ${r}" >&2; ok=0; }
        if (( ok )); then
            # `gog git` prints a "Repository:" header on stdout, so take the last line.
            rev=$(gog -r "${r}" git rev-parse --short HEAD | tail -n 1)
            echo "Up-to-date: ${rev}"
        else
            failed=1
        fi
    done
    return ${failed}
}

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\W\[\033[00m\]\$ '
PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"

# JavaScript
# nvm's install script puts nvm.sh in ~/.nvm; Homebrew puts it in its prefix
# and keeps only the installed versions in ~/.nvm.
export NVM_DIR="${HOME}/.nvm"
for f in "${NVM_DIR}" /opt/homebrew/opt/nvm; do
    if [[ -s ${f}/nvm.sh ]]; then
        source "${f}"/nvm.sh
        for c in "${f}"/bash_completion "${f}"/etc/bash_completion.d/nvm; do
            if [[ -s ${c} ]]; then
                source "${c}"
            fi
        done
        break
    fi
done
unset c f

# Kubernetes
if command -v kubectl >/dev/null; then
    source <(runCached kubectl completion bash)
fi

# Ruby
for f in /usr/local/share/chruby /opt/homebrew/Cellar/chruby/*/share/chruby; do
    if [[ -d ${f} ]]; then
        source "${f}"/chruby.sh
        source "${f}"/auto.sh
        break
    fi
done
unset f

# Rust
if [[ -f "${HOME}/.cargo/env" ]]; then
    source "${HOME}/.cargo/env"
fi
